<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve existing files and directories normally; send every other request
  # to the React single-page application entry point.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirect legacy React URLs such as /about-us.html to /about-us.
  # Use a temporary redirect while testing; change 302 to 301 when confirmed.
  RewriteRule ^(.+)\.html$ /$1 [R=302,L]

  RewriteRule ^ index.html [L]
</IfModule>

